---
import SectionHead from './SectionHead.astro';
import { TOPICS } from '../data/meetup';
---

<section class="section" id="topics">
	<div class="shell">
		<SectionHead
			label="Topics"
			note="Recurring subjects across our sessions"
		/>

		<ul class="voices">
			{
				TOPICS.map((topic, i) => (
					<li class="voice rise" style={`--rise-delay: ${i * 70}ms`}>
						<h3 class="name"><span>{topic.name}</span></h3>
						<p class="note">{topic.note}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.section {
		position: relative;
		z-index: 2;
		background: var(--color-screen);
		padding-block: 0 var(--section-gap);
	}

	.voices {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* One flush left edge, top to bottom. The voices used to step further in
	   as they entered; that indent moved every name and note along the x-axis
	   and made the column impossible to read down. Whitespace separates them
	   now, and nothing on this list moves horizontally. */
	.voice {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
		gap: clamp(var(--space-2), 4vw, var(--space-6));
		align-items: baseline;
		padding: clamp(var(--space-3), 2.6vw, var(--space-5)) 0;
	}

	/* 400 throughout. Hover opens the width axis, never the weight axis. */
	.name {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 100, 'wght' 400;
		font-size: var(--text-heading-sm);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: var(--tracking-display);
		margin: 0;
		transition: font-variation-settings 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* The hovered row underlines itself, the rule growing from the left to
	   the measure of the name. Drawn as a background rather than a border so
	   it spans the text and not the grid column, and so its width is a single
	   animatable property. */
	.name span {
		position: relative;
	}

	/* Drawn as a positioned child rather than a background: a background is
	   painted only inside the padding box, and this font's em box is ~1.02em,
	   so a rule set low enough to clear the descenders falls outside it and is
	   clipped away. An absolutely positioned rule has no such ceiling. It
	   spans the span, which is inline and therefore measures the text and not
	   the grid column, and it grows on a transform, which the compositor can
	   animate without laying the row out again. */
	.name span::after {
		content: '';
		position: absolute;
		left: 0;
		top: 1.08em;
		width: 100%;
		height: 2px;
		background: var(--color-added);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.voice:hover .name span::after {
		transform: scaleX(1);
	}

	.note {
		margin: 0;
		color: var(--color-fg-3);
		font-size: var(--text-body);
		font-weight: var(--weight-body);
		line-height: 1.5;
		max-width: 40ch;
		text-wrap: pretty;
		transition: color 0.3s ease;
	}

	.voice:hover .name {
		font-variation-settings: 'wdth' 128, 'wght' 400;
	}

	.voice:hover .note {
		color: var(--color-fg-2);
	}

	@media (max-width: 780px) {
		.voice {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}
</style>
