---
import SectionHead from './SectionHead.astro';
import { TOPICS } from '../data/meetup';
---

<section class="section" id="topics">
	<div class="shell">
		<SectionHead
			label="What comes up"
			note="Open a topic to read more"
		/>

		<div class="accordion">
			{
				TOPICS.map((topic, i) => (
					<details
						class="item rise"
						name="topics"
						open={i === 0}
						style={`--rise-delay: ${i * 70}ms`}
					>
						<summary class="trigger">
							<h3 class="name">{topic.name}</h3>
						</summary>
						<div class="answer">
							<p class="note">{topic.note}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.section {
		position: relative;
		z-index: 2;
		background: var(--color-ink);
		padding-block: 0 clamp(4.5rem, 12vw, 9rem);
	}

	.accordion {
		border-top: 1px solid rgba(239, 233, 220, 0.12);
	}

	.item {
		border-bottom: 1px solid rgba(239, 233, 220, 0.12);
	}

	.trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: clamp(1.1rem, 2.4vw, 1.6rem) 0;
		cursor: pointer;
		list-style: none;
		color: var(--color-paper);
		user-select: none;
	}

	.trigger::-webkit-details-marker {
		display: none;
	}

	.trigger::marker {
		content: '';
	}

	.trigger::after {
		content: '+';
		flex: none;
		display: grid;
		place-items: center;
		width: 1.8rem;
		height: 1.8rem;
		border: 1px solid rgba(239, 233, 220, 0.22);
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1;
		color: var(--color-paper-3);
		transition:
			border-color 0.25s ease,
			color 0.25s ease,
			background-color 0.25s ease;
	}

	.item:nth-child(3n + 1) .trigger::after {
		color: var(--color-cyan);
	}

	.item:nth-child(3n + 2) .trigger::after {
		color: var(--color-magenta);
	}

	.item:nth-child(3n + 3) .trigger::after {
		color: var(--color-yellow);
	}

	.item[open] .trigger::after {
		content: '\2212';
		border-color: currentColor;
		background: rgba(239, 233, 220, 0.04);
	}

	.name {
		min-width: 0;
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 104, 'wght' 640;
		font-size: clamp(1.35rem, 3.2vw, 2.35rem);
		line-height: 1.05;
		letter-spacing: -0.015em;
		margin: 0;
		transition: color 0.25s ease;
	}

	.trigger:hover .name,
	.item[open] .name {
		color: var(--color-paper-2);
	}

	.answer {
		padding: 0 clamp(3.3rem, 7vw, 5rem) clamp(1.35rem, 3vw, 2rem) 0;
	}

	.note {
		margin: 0;
		color: var(--color-paper-3);
		font-size: 0.9375rem;
		line-height: 1.6;
		max-width: 58ch;
		text-wrap: pretty;
	}

</style>
