---
/**
 * A transparent bar sitting directly on the lattice — no backdrop, no blur,
 * no bottom rule. Mark and wordmark left, ghost links right, and exactly one
 * filled pill anchoring the edge.
 */
import { NEXT } from '../data/meetup';

const LINKS = [
	{ href: '#about', label: 'About' },
	{ href: '#topics', label: 'Topics' },
	{ href: '#evening', label: 'Format' },
];
---

<nav class="nav" aria-label="Primary">
	<div class="shell nav-inner">
		<a class="brand" href="#top">
			{/* A shell prompt and its block cursor. */}
			<svg class="caret" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M3 5 L10 12 L3 19"></path>
				<rect x="13" y="4" width="8" height="16"></rect>
			</svg>
			<span class="wordmark">l<span class="ai">AI</span>pzig</span>
		</a>

		<div class="right">
			<ul class="links">
				{
					LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>

			<a class="btn btn-primary" href="#next">
				Attend
				<span class="btn-date">{NEXT.short}</span>
			</a>
		</div>
	</div>
</nav>

<style>
	.nav {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		padding-block: var(--space-4);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		text-decoration: none;
	}

	.caret {
		flex: none;
		width: 16px;
		height: 16px;
	}

	.caret path {
		fill: none;
		stroke: var(--color-fg-3);
		stroke-width: 1.6;
	}

	.caret rect {
		fill: var(--color-added);
		stroke: none;
	}

	/* The wordmark sits at nav scale but keeps the display voice, so the
	   header reads as a smaller printing of the hero rather than a logo. */
	.wordmark {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 128, 'wght' 400;
		font-size: var(--text-nav);
		font-weight: 400;
		letter-spacing: -0.01em;
		color: var(--color-fg);
	}

	/* AI is a selection, not an outline — the same gesture as the hero. */
	.ai {
		background-image: linear-gradient(var(--color-added), var(--color-added));
		background-repeat: no-repeat;
		background-size: 100% var(--select-band);
		background-position: 0 var(--select-top);
		color: var(--color-screen);
		padding-inline: 0.06em;
	}

	.right {
		display: flex;
		align-items: center;
		gap: clamp(var(--space-3), 3vw, var(--space-6));
	}

	.links {
		display: flex;
		align-items: center;
		gap: clamp(var(--space-3), 2.5vw, var(--space-5));
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Ghost links: no container at all. Hierarchy is tracking and colour. */
	.links a {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-fg-3);
		transition: color 0.2s ease;
	}

	.links a:hover {
		color: var(--color-fg);
	}

	@media (max-width: 720px) {
		.links {
			display: none;
		}
	}
</style>
