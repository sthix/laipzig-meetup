---
import SectionHead from './SectionHead.astro';
---

<section class="section" id="about">
	<div class="shell">
		<SectionHead label="About" />

		<div class="duo">
			{/* A statement, not a heading — "About" above is the heading. */}
			<p class="head rise">
				For people building<br />with <em>AI</em> in Leipzig.
			</p>

			<div class="body rise" style="--rise-delay: 120ms">
				<p class="lede">
					The field moves quickly. Tools, papers and practices change from month
					to month, and a good deal of what works in production has not been
					written down anywhere yet.
				</p>
				<p class="lede">
					We meet to close that gap. Members present what they have built,
					describe what did not work, and take questions from the room. The
					group is open to anyone with an interest in the subject, whatever
					their background.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.section {
		position: relative;
		z-index: 2;
		background: var(--color-ink);
		padding-block: var(--section-gap);
	}

	/* Emphasis by misregistration: two plates a hair out of alignment, the way
	   a press drifts. Held tighter now that the stems are 400 and not 760 —
	   at this weight a wide offset reads as a mistake rather than a print. */
	.head em {
		font-style: normal;
		color: var(--color-paper);
		text-shadow:
			0.03em -0.019em 0 var(--color-cyan),
			-0.026em 0.019em 0 var(--color-magenta);
	}

	.body {
		max-width: 32rem;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-top: 0.4rem;
	}
</style>
