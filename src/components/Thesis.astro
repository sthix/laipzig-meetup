---
import SectionHead from './SectionHead.astro';
---

<section class="section" id="about">
	<div class="shell">
		<SectionHead label="About" />

		<div class="duo">
			{/* A statement, not a heading — "About" above is the heading. */}
			<p class="head rise">
				For people building<br />with <em>AI</em> in Leipzig.
			</p>

			<div class="body rise" style="--rise-delay: 120ms">
				<p class="lede">
					The field moves quickly. Tools, papers and practices change from month
					to month, and a good deal of what works in production has not been
					written down anywhere yet.
				</p>
				<p class="lede">
					We meet to close that gap. Members present what they have built,
					describe what did not work, and take questions from the room. The
					group is open to anyone with an interest in the subject, whatever
					their background.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.section {
		position: relative;
		z-index: 2;
		background: var(--color-screen);
		padding-block: var(--section-gap);
	}

	/* Emphasis is a selection — the same gesture as the wordmark, and the same
	   two colours a real text selection uses on this page. */
	.head em {
		font-style: normal;
		background-image: linear-gradient(var(--color-added), var(--color-added));
		background-repeat: no-repeat;
		background-size: 100% var(--select-band);
		background-position: 0 var(--select-top);
		color: var(--color-screen);
		padding-inline: 0.05em;
	}

	.body {
		max-width: 32rem;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-top: 0.4rem;
	}
</style>
