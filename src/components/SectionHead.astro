---
interface Props {
	label: string;
	note?: string;
	id?: string;
}

const { label, note, id } = Astro.props;
---

<div class="sec-head rise" id={id}>
	{/* Registration target and ink-density bars — the two marks a press puts
	    in the trim margin. Held as a tight cluster rather than stretched on a
	    rule, because nothing on this page draws a line across the column. */}
	<span class="marks" aria-hidden="true">
		<svg class="reg" viewBox="0 0 24 24">
			<circle cx="12" cy="12" r="6.5"></circle>
			<path d="M12 0v24M0 12h24"></path>
		</svg>
		<span class="bars"><i></i><i></i><i></i></span>
	</span>

	<h2 class="label">{label}</h2>
	{note && <span class="note">{note}</span>}
</div>

<style>
	.sec-head {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding-bottom: clamp(var(--space-5), 5vw, var(--space-10));
	}

	.marks {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		flex: none;
	}

	.reg {
		width: 14px;
		height: 14px;
		stroke: var(--color-cyan);
		stroke-width: 1.1;
		fill: none;
	}

	.bars {
		display: flex;
		gap: 2px;
	}

	.bars i {
		width: 10px;
		height: 4px;
	}

	.bars i:nth-child(1) {
		background: var(--color-cyan);
	}
	.bars i:nth-child(2) {
		background: var(--color-magenta);
	}
	.bars i:nth-child(3) {
		background: var(--color-yellow);
	}

	.label {
		white-space: nowrap;
	}

	.note {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: 400;
		letter-spacing: 0.06em;
		line-height: 1.2;
		color: var(--color-paper-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (max-width: 720px) {
		.note {
			display: none;
		}
	}
</style>
