---
interface Props {
	label: string;
	note?: string;
	id?: string;
}

const { label, note, id } = Astro.props;
---

<div class="sec-head rise" id={id}>
	{/* The prompt, and a diff gutter beside it. A tight cluster rather than
	    something stretched on a rule, because nothing on this page draws a
	    line across the column. */}
	<span class="marks" aria-hidden="true">
		<svg class="caret" viewBox="0 0 24 24">
			<path d="M3 5 L10 12 L3 19"></path>
			<rect x="13" y="4" width="8" height="16"></rect>
		</svg>
		<span class="gutter"><i></i><i></i><i></i></span>
	</span>

	<h2 class="label">{label}</h2>
	{note && <span class="note">{note}</span>}
</div>

<style>
	.sec-head {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding-bottom: clamp(var(--space-5), 5vw, var(--space-10));
	}

	.marks {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		flex: none;
	}

	.caret {
		width: 15px;
		height: 15px;
	}

	.caret path {
		fill: none;
		stroke: var(--color-fg-3);
		stroke-width: 1.6;
	}

	.caret rect {
		fill: var(--color-added);
		stroke: none;
	}

	/* Added, removed, unchanged — the three marks a gutter can carry. */
	.gutter {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.gutter i {
		width: 10px;
		height: 3px;
	}

	.gutter i:nth-child(1) {
		background: var(--color-added);
	}
	.gutter i:nth-child(2) {
		background: var(--color-removed);
	}
	.gutter i:nth-child(3) {
		background: var(--color-fg-3);
	}

	.label {
		white-space: nowrap;
	}

	.note {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: 400;
		letter-spacing: 0.06em;
		line-height: 1.2;
		color: var(--color-fg-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (max-width: 720px) {
		.note {
			display: none;
		}
	}
</style>
