<header class="hero" id="top">
	<div class="shell hero-inner">
		<p class="micro hero-mark">
			<span>51.3397&deg; N</span>
			<span class="tick" aria-hidden="true"></span>
			<span>12.3731&deg; E</span>
			<span class="tick" aria-hidden="true"></span>
			<span>Leipzig</span>
		</p>

		<h1 class="wordmark">
			<span>l</span><span class="ai">AI</span><span>pzig</span>
		</h1>

		<div class="say">
			<p class="label hero-label">Monthly AI meetup in Leipzig</p>

			<p class="lede">
				A monthly meetup for people working with AI in and around Leipzig
				&mdash; developers, researchers, students, and anyone curious about the
				field. Free to attend, with no background assumed.
			</p>

			<div class="actions">
				<a class="btn btn-primary" href="#next">Attend the next meetup</a>
				<a class="btn btn-ghost" href="#topics">See the topics</a>
			</div>
		</div>
	</div>

	<a class="scroll-cue" href="#about" aria-label="Scroll to the about section">
		<span class="micro">Scroll</span>
		<span class="cue-line" aria-hidden="true"></span>
	</a>
</header>

<style>
	.hero {
		position: relative;
		z-index: 2;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: clamp(7rem, 16vh, 10rem) clamp(5rem, 12vh, 7rem);
	}

	/* The scrim is banded, not flat: heavy where the small type sits, nearly
	   open across the wordmark so the lattice stays visible through the cut. */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(
			to bottom,
			rgba(11, 11, 11, 0.72) 0%,
			rgba(11, 11, 11, 0.3) 20%,
			rgba(11, 11, 11, 0.24) 46%,
			rgba(11, 11, 11, 0.74) 62%,
			rgba(11, 11, 11, 0.86) 100%
		);
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
	}

	.hero-mark {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--color-fg-2);
		margin: 0 0 clamp(1.25rem, 4vh, 2.5rem);
		opacity: 0;
		animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.05s forwards;
	}

	.tick {
		width: 1.75rem;
		height: 1px;
		background: currentColor;
		opacity: 0.45;
	}

	/* ---- Wordmark ------------------------------------------------------ */

	/* Weightless by rule: 400 at every display size, the width axis and the
	   sheer measure carrying the hierarchy instead of a heavy stem. Dropping
	   from 800 to 400 narrowed the word — at 'wdth' 142 with -0.04em it now
	   measures 4.467x its font size, against 5.07x before — so the size that
	   fills the column had to come up with it. The shell gives the word 90vw
	   (its content capped near 1136px), and 90/4.467 ≈ 20vw is what fills it —
	   held a hair under that so subpixel rounding never clips the g.
	   The wordmark still sets the measure of the page at every width. */
	.wordmark {
		font-family: var(--font-display);
		font-size: min(19.9vw, 15.75rem);
		font-weight: 400;
		line-height: 0.86;
		letter-spacing: var(--tracking-display);
		margin: 0;
		white-space: nowrap;
		font-variation-settings: 'wdth' 142, 'wght' 400;
		animation: render 1.5s cubic-bezier(0.19, 1, 0.22, 1) 0.15s backwards;
	}

	/* AI is selected, not outlined. The block is painted as a background so
	   it can be wiped in from the left like a cursor dragging over the word;
	   the static state is the full block, so with animation suppressed the
	   selection is simply already there. */
	.ai {
		color: var(--color-screen);
		background-image: linear-gradient(var(--color-added), var(--color-added));
		background-repeat: no-repeat;
		background-size: 100% var(--select-band);
		background-position: 0 var(--select-top);
		padding-inline: 0.03em;
		animation: select 0.62s steps(14, end) 1.02s backwards;
	}

	@keyframes select {
		from {
			background-size: 0% var(--select-band);
		}
		to {
			background-size: 100% var(--select-band);
		}
	}

	/* The word coming up on the screen: narrow and unresolved, widening as it
	   settles, with the phosphor glow decaying off it. */
	@keyframes render {
		0% {
			font-variation-settings: 'wdth' 88, 'wght' 400;
			opacity: 0;
			filter: blur(6px);
			text-shadow: 0 0 0.34em rgba(75, 217, 122, 0.85);
		}
		38% {
			opacity: 1;
			filter: blur(0);
		}
		100% {
			font-variation-settings: 'wdth' 142, 'wght' 400;
			opacity: 1;
			filter: blur(0);
			text-shadow: 0 0 0 rgba(75, 217, 122, 0);
		}
	}

	/* Everything under the wordmark is one narrow column on the left half —
	   the right half stays open onto the lattice. */
	/* The copy column is held to the reference's 480px measure; the actions
	   sit outside it so the two pills never wrap against each other. */
	.say {
		margin-top: clamp(1.5rem, 4vh, 2.5rem);
	}

	.hero-label,
	.lede {
		max-width: 30rem;
	}

	.hero-label {
		opacity: 0;
		animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
	}

	.lede {
		margin-top: var(--space-4);
		color: var(--color-fg);
		opacity: 0;
		animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.35s forwards;
	}

	/* ---- Actions ------------------------------------------------------- */

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: clamp(1.75rem, 4.5vh, 2.75rem);
		opacity: 0;
		animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.5s forwards;
	}

	/* ---- Scroll cue ---------------------------------------------------- */

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: clamp(1.5rem, 4vh, 2.5rem);
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		opacity: 0;
		animation: fade-up 0.9s ease 1.9s forwards;
	}

	.cue-line {
		width: 1px;
		height: 2.5rem;
		background: linear-gradient(
			to bottom,
			rgba(230, 230, 230, 0.5),
			rgba(230, 230, 230, 0)
		);
	}

	.scroll-cue:hover .micro {
		color: var(--color-added);
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(1rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* The coordinate strip is too long for the ticks below this width. */
	@media (max-width: 560px) {
		.hero-mark {
			gap: 0.7rem;
			letter-spacing: 0.16em;
		}

		.tick {
			display: none;
		}
	}

	/* On a short viewport the hero column runs down into the cue's corner. */
	@media (max-height: 700px) {
		.scroll-cue {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.actions .btn {
			flex: 1 1 100%;
			justify-content: center;
		}

		.scroll-cue {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wordmark,
		.hero-mark,
		.hero-label,
		.lede,
		.actions,
		.scroll-cue,
		.ai {
			opacity: 1;
			animation: none;
		}
	}
</style>
