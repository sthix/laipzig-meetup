---
import SectionHead from './SectionHead.astro';
import { SCHEDULE } from '../data/meetup';
---

<section class="section" id="evening">
	<div class="shell">
		<SectionHead label="The evening" note="Roughly. It slips." />

		<ol class="score">
			{
				SCHEDULE.map((slot, i) => (
					<li class="slot rise" style={`--rise-delay: ${i * 80}ms`}>
						<time class="clock">{slot.time}</time>
						<div class="what">
							<h3 class="name">{slot.name}</h3>
							<p class="note">{slot.note}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.section {
		position: relative;
		z-index: 2;
		background: var(--color-ink);
		padding-block: 0 clamp(4.5rem, 12vw, 9rem);
	}

	.score {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		background: rgba(239, 233, 220, 0.12);
		border: 1px solid rgba(239, 233, 220, 0.12);
	}

	.slot {
		background: var(--color-ink);
		padding: clamp(1.25rem, 2.5vw, 1.9rem);
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		transition: background-color 0.3s ease;
	}

	.slot:hover {
		background: var(--color-ink-2);
	}

	.clock {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		color: var(--color-cyan);
	}

	.what {
		margin-top: auto;
	}

	.name {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 108, 'wght' 640;
		font-size: clamp(1.15rem, 1.9vw, 1.45rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		margin: 0 0 0.5rem;
	}

	.note {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--color-paper-3);
		text-wrap: pretty;
	}

	@media (max-width: 900px) {
		.score {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.score {
			grid-template-columns: 1fr;
		}

		.slot {
			flex-direction: row;
			align-items: baseline;
			gap: 1.25rem;
		}

		.clock {
			flex: none;
			width: 3.5rem;
		}

		.what {
			margin-top: 0;
		}
	}
</style>
