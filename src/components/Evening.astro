---
import SectionHead from './SectionHead.astro';
import { SCHEDULE } from '../data/meetup';
---

<section class="section" id="evening">
	<div class="shell">
		<SectionHead label="Format" note="The usual order of an evening" />

		{/* Flipped against the section above it: the big type moves to the
		    right-hand column so the page reads as a zigzag, not a stack. */}
		<div class="duo duo-flip">
			<p class="head rise">Talks, demos,<br />and discussion.</p>

			<ol class="score">
				{
					SCHEDULE.map((slot, i) => (
						<li class="slot rise" style={`--rise-delay: ${i * 80}ms`}>
							<span class="step">{String(i + 1).padStart(2, '0')}</span>
							<div class="what">
								<h3 class="name">{slot.name}</h3>
								<p class="note">{slot.note}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.section {
		position: relative;
		z-index: 2;
		background: var(--color-screen);
		padding-block: 0 var(--section-gap);
	}

	/* Was a four-up grid of bordered cells. Cells are gone: the slots float on
	   the ground and the step column alone holds the alignment. */
	.score {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: clamp(var(--space-4), 3vw, var(--space-6));
		max-width: 34rem;
	}

	.slot {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		gap: var(--space-3);
		align-items: baseline;
	}

	/* Was the clock. Nothing is scheduled, so the column counts the steps
	   instead — which reads as a gutter's line numbers, the same place the
	   diff marks sit elsewhere on the page. */
	.step {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: 500;
		letter-spacing: 0.1em;
		color: var(--color-added);
	}

	.name {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 108, 'wght' 400;
		font-size: var(--text-heading-2xs);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-1);
	}

	.note {
		margin: 0;
		font-size: var(--text-body);
		font-weight: var(--weight-body);
		line-height: 1.5;
		color: var(--color-fg-3);
		text-wrap: pretty;
	}

	@media (max-width: 880px) {
		.score {
			max-width: none;
		}
	}

	@media (max-width: 520px) {
		.slot {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}
</style>
