---
import { NEXT, LINKS } from '../data/meetup';
---

<section class="section" id="next">
	<div class="shell">
		<div class="panel rise">
			<div class="top">
				<h2 class="micro">Next meetup</h2>
				<span class="rule" aria-hidden="true"></span>
				<span class="micro live"><i aria-hidden="true"></i>Open to all</span>
			</div>

			<time class="date" datetime={NEXT.iso}>
				<span class="day">{NEXT.day}</span>
				<span class="rest">
					<span class="month">{NEXT.month}</span>
					<span class="micro meta">
						{NEXT.weekday} &middot; {NEXT.time} &middot; {NEXT.city} &middot; {NEXT.year}
					</span>
				</span>
			</time>

			<div class="bottom">
				<p class="fine">
					Free, no ticket, no registration desk. The venue is announced with the
					date &mdash; put your name down and it lands in your inbox two weeks
					ahead.
				</p>
				<a class="btn" href={LINKS.announce}>Get the announcement</a>
			</div>
		</div>
	</div>
</section>

<style>
	/* Transparent by design: this is the second window onto the lattice. */
	.section {
		position: relative;
		z-index: 2;
		padding-block: clamp(5rem, 14vw, 10rem);
	}

	.section::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			linear-gradient(to bottom, var(--color-ink), rgba(8, 6, 15, 0) 22%),
			linear-gradient(to top, var(--color-ink), rgba(8, 6, 15, 0) 22%),
			radial-gradient(
				90% 70% at 50% 50%,
				rgba(8, 6, 15, 0.78) 0%,
				rgba(8, 6, 15, 0.45) 55%,
				rgba(8, 6, 15, 0.1) 100%
			);
	}

	.panel {
		border: 1px solid rgba(239, 233, 220, 0.22);
		padding: clamp(1.5rem, 3.5vw, 2.75rem);
	}

	.top {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.top .micro {
		margin: 0;
		font-size: 0.625rem;
		color: var(--color-paper);
		white-space: nowrap;
	}

	.rule {
		flex: 1 1 auto;
		height: 1px;
		background: rgba(239, 233, 220, 0.18);
	}

	.live {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--color-magenta) !important;
	}

	.live i {
		width: 6px;
		height: 6px;
		background: var(--color-magenta);
		border-radius: 50%;
		animation: pulse 2.4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
			box-shadow: 0 0 0 0 rgba(236, 0, 140, 0.5);
		}
		50% {
			opacity: 0.65;
			box-shadow: 0 0 0 6px rgba(236, 0, 140, 0);
		}
	}

	/* ---- The date ------------------------------------------------------ */

	.date {
		display: flex;
		align-items: flex-end;
		gap: clamp(1rem, 3vw, 2.25rem);
		padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	/* Cut through, same as the AI in the wordmark. Two windows, one page. */
	.day {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 138, 'wght' 800;
		font-size: clamp(5rem, 19vw, 15rem);
		line-height: 0.74;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 0.013em rgba(239, 233, 220, 0.7);
		paint-order: stroke fill;
	}

	.rest {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding-bottom: 0.35rem;
	}

	.month {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 108, 'wght' 620;
		font-size: clamp(1.5rem, 4vw, 3rem);
		line-height: 0.9;
		letter-spacing: -0.02em;
	}

	.meta {
		color: var(--color-paper-2);
	}

	/* ---- Bottom -------------------------------------------------------- */

	.bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		border-top: 1px solid rgba(239, 233, 220, 0.18);
		padding-top: clamp(1.25rem, 3vw, 1.75rem);
	}

	.fine {
		margin: 0;
		max-width: 52ch;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--color-paper-2);
		text-wrap: pretty;
	}

	.btn {
		flex: none;
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.35rem;
		background: var(--color-paper);
		color: var(--color-ink);
		border: 1px solid var(--color-paper);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease,
			transform 0.25s ease;
	}

	.btn:hover {
		background: var(--color-cyan);
		border-color: var(--color-cyan);
		transform: translateY(-2px);
	}

	@media (max-width: 640px) {
		.date {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.9rem;
		}

		.day {
			font-variation-settings: 'wdth' 118, 'wght' 800;
		}

		.btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
