---
import { NEXT, LINKS } from '../data/meetup';
---

<section class="section" id="next">
	<div class="shell">
		<div class="duo rise">
			{/* Cut through, same as the AI in the wordmark. Two windows, one page. */}
			<time class="date" datetime={NEXT.iso}>
				<span class="day">{NEXT.day}</span>
				<span class="month">{NEXT.month}</span>
			</time>

			<div class="say">
				<div class="top">
					<p class="label">Next meetup</p>
					<span class="live"><i aria-hidden="true"></i>Open to all</span>
				</div>

				<p class="meta micro">
					{NEXT.weekday} &middot; {NEXT.time} &middot; {NEXT.city} &middot; {
						NEXT.year
					}
				</p>

				<p class="lede">
					Free, no ticket, no registration desk. The venue is announced with the
					date &mdash; put your name down and it lands in your inbox two weeks
					ahead.
				</p>

				<a class="btn btn-primary" href={LINKS.announce}>Get the announcement</a>
			</div>
		</div>
	</div>
</section>

<style>
	/* Transparent by design: this is the second window onto the lattice. The
	   panel that used to frame it is gone — the scrim alone holds the type. */
	.section {
		position: relative;
		z-index: 2;
		padding-block: var(--section-gap);
	}

	.section::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			linear-gradient(to bottom, var(--color-ink), rgba(8, 6, 15, 0) 22%),
			linear-gradient(to top, var(--color-ink), rgba(8, 6, 15, 0) 22%),
			radial-gradient(
				90% 70% at 50% 50%,
				rgba(8, 6, 15, 0.78) 0%,
				rgba(8, 6, 15, 0.45) 55%,
				rgba(8, 6, 15, 0.1) 100%
			);
	}

	.duo {
		align-items: center;
	}

	/* ---- The date ------------------------------------------------------ */

	.date {
		display: flex;
		flex-direction: column;
	}

	.day {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 138, 'wght' 400;
		font-size: var(--text-display);
		font-weight: 400;
		line-height: 0.8;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 0.012em rgba(239, 233, 220, 0.7);
		paint-order: stroke fill;
	}

	.month {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 108, 'wght' 400;
		font-size: var(--text-heading-sm);
		font-weight: 400;
		line-height: 1;
		letter-spacing: var(--tracking-display);
		margin-top: var(--space-2);
	}

	/* ---- The right column ---------------------------------------------- */

	.say {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		max-width: 32rem;
	}

	.top {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	/* The one place magenta is allowed to speak: a live marker, nothing else. */
	.live {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: var(--weight-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-magenta);
	}

	.live i {
		width: 6px;
		height: 6px;
		background: var(--color-magenta);
		border-radius: 50%;
		animation: pulse 2.4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
			box-shadow: 0 0 0 0 rgba(236, 0, 140, 0.5);
		}
		50% {
			opacity: 0.65;
			box-shadow: 0 0 0 6px rgba(236, 0, 140, 0);
		}
	}

	.meta {
		margin: 0;
		color: var(--color-paper-2);
	}

	.lede {
		color: var(--color-paper-2);
	}

	.say > .btn {
		margin-top: var(--space-1);
	}

	@media (max-width: 640px) {
		.say > .btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
