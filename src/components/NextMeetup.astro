---
import { NEXT, LINKS } from '../data/meetup';
---

<section class="section" id="next">
	<div class="shell">
		<div class="duo rise">
			{/* Drawn but not filled. Nothing is scheduled yet, so the slot the
			    section is built around says so rather than standing empty — and
			    it is no longer a <time>, having nothing to put in datetime. */}
			<p class="date">
				<span class="day">Date</span>
				<span class="month">to be announced</span>
			</p>

			<div class="say">
				<div class="top">
					<p class="label">Next meetup</p>
					<span class="live"><i aria-hidden="true"></i>Open to all</span>
				</div>

				<p class="meta micro">{NEXT.city}</p>

				<p class="lede">
					Attendance is free and no registration is required. The date and the
					venue are announced together &mdash; join the announcement list and
					they reach you two weeks ahead.
				</p>

				<a class="btn btn-primary" href={LINKS.announce}>Join the announcement list</a>
			</div>
		</div>
	</div>
</section>

<style>
	/* Transparent by design: this is the second window onto the lattice. The
	   panel that used to frame it is gone — the scrim alone holds the type. */
	.section {
		position: relative;
		z-index: 2;
		padding-block: var(--section-gap);
	}

	.section::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			linear-gradient(to bottom, var(--color-screen), rgba(11, 11, 11, 0) 22%),
			linear-gradient(to top, var(--color-screen), rgba(11, 11, 11, 0) 22%),
			radial-gradient(
				90% 70% at 50% 50%,
				rgba(11, 11, 11, 0.78) 0%,
				rgba(11, 11, 11, 0.45) 55%,
				rgba(11, 11, 11, 0.1) 100%
			);
	}

	.duo {
		align-items: center;
	}

	/* ---- The date ------------------------------------------------------ */

	.date {
		display: flex;
		flex-direction: column;
	}

	.day {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 138, 'wght' 400;
		font-size: var(--text-display);
		font-weight: 400;
		line-height: 0.8;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 0.012em rgba(230, 230, 230, 0.7);
		paint-order: stroke fill;
	}

	.month {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 108, 'wght' 400;
		font-size: var(--text-heading-sm);
		font-weight: 400;
		line-height: 1;
		letter-spacing: var(--tracking-display);
		margin-top: var(--space-2);
	}

	/* ---- The right column ---------------------------------------------- */

	.say {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		max-width: 32rem;
	}

	.top {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	/* A status marker, so it reads as healthy rather than as an alert. */
	.live {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: var(--weight-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-added);
	}

	.live i {
		width: 6px;
		height: 6px;
		background: var(--color-added);
		border-radius: 50%;
		animation: pulse 2.4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 1;
			box-shadow: 0 0 0 0 rgba(75, 217, 122, 0.5);
		}
		50% {
			opacity: 0.65;
			box-shadow: 0 0 0 6px rgba(75, 217, 122, 0);
		}
	}

	.meta {
		margin: 0;
		color: var(--color-fg-2);
	}

	.lede {
		color: var(--color-fg-2);
	}

	.say > .btn {
		margin-top: var(--space-1);
	}

	@media (max-width: 640px) {
		.say > .btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
