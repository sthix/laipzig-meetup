---
import { LINKS } from '../data/meetup';
---

<footer class="foot">
	<div class="shell">
		<div class="row">
			<div class="cols">
				<div class="col">
					<span class="label">Find us</span>
					<a href={LINKS.meetup}>Meetup</a>
					<a href={LINKS.github}>GitHub</a>
					<a href={LINKS.email}>hallo@laipzig.dev</a>
				</div>

				<div class="col">
					<span class="label">Take part</span>
					<p>Give a talk, show a demo, or simply attend.</p>
				</div>

				<div class="col">
					<span class="label">Where</span>
					<p>
						Leipzig, Germany<br /><span class="coords"
							>51.3397&deg; N, 12.3731&deg; E</span
						>
					</p>
				</div>
			</div>

			<p class="wordmark" aria-hidden="true">l<span>AI</span>pzig</p>
		</div>

		<p class="colophon">
			Background: a gyroid minimal surface &mdash; three interlocking sine waves,
			raymarched in real time. Set in Anybody, Archivo and Martian Mono.
		</p>
	</div>
</footer>

<style>
	/* No top rule. The section gap above it is the separation. */
	.foot {
		position: relative;
		z-index: 2;
		background: var(--color-screen);
		padding-block: var(--section-gap) clamp(var(--space-5), 4vw, var(--space-6));
	}

	.row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: clamp(var(--space-5), 6vw, var(--space-16));
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, auto));
		gap: clamp(var(--space-4), 5vw, var(--space-10));
	}

	.col {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		align-items: flex-start;
	}

	.col .label {
		margin-bottom: var(--space-1);
	}

	/* Ghost links: colour and nothing else. The underline that used to sit
	   under every one of these was the last border on the page. */
	.col a {
		font-size: var(--text-body);
		font-weight: var(--weight-body);
		text-decoration: none;
		color: var(--color-fg);
		transition: color 0.2s ease;
	}

	.col a:hover {
		color: var(--color-added);
	}

	.col p {
		margin: 0;
		font-size: var(--text-body);
		font-weight: var(--weight-body);
		line-height: 1.5;
		color: var(--color-fg-2);
		max-width: 24ch;
	}

	.coords {
		white-space: nowrap;
		color: var(--color-fg-3);
	}

	.wordmark {
		margin: 0;
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 132, 'wght' 400;
		font-size: var(--text-subheading);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: var(--tracking-display);
		color: rgba(230, 230, 230, 0.16);
		white-space: nowrap;
	}

	.wordmark span {
		color: rgba(75, 217, 122, 0.5);
	}

	.colophon {
		margin: clamp(var(--space-6), 6vw, var(--space-10)) 0 0;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 400;
		letter-spacing: 0.06em;
		line-height: 1.9;
		color: var(--color-fg-3);
		max-width: 68ch;
	}

	@media (max-width: 860px) {
		.row {
			flex-direction: column-reverse;
		}

		.cols {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}
	}
</style>
