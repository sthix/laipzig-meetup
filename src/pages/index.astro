---
import Layout from '../layouts/Layout.astro';
import GyroidField from '../components/GyroidField.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import Thesis from '../components/Thesis.astro';
import Topics from '../components/Topics.astro';
import Evening from '../components/Evening.astro';
import NextMeetup from '../components/NextMeetup.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
	<GyroidField />

	<a class="skip" href="#about">Skip to content</a>

	<SiteNav />
	<Hero />

	<main>
		<Thesis />
		<Topics />
		<Evening />
		<NextMeetup />
	</main>

	<SiteFooter />
</Layout>

<style is:global>
	.skip {
		position: absolute;
		left: -9999px;
		z-index: 30;
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius-pill);
		background: var(--color-cyan);
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.skip:focus {
		left: 1rem;
		top: 1rem;
	}
</style>

<script>
	// One reveal mechanic for the whole page.
	const items = document.querySelectorAll<HTMLElement>('.rise');

	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && items.length) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-in');
						io.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
		);

		items.forEach((el) => io.observe(el));
	} else {
		items.forEach((el) => el.classList.add('is-in'));
	}
</script>
