---
/**
 * Scratch page — three replacements for the printing metaphor, set side by
 * side in the same specimen so the palettes and marks can be compared
 * directly. Not linked from the site. Delete once a direction is chosen.
 */
import Layout from '../layouts/Layout.astro';

const VARIANTS = [
	{
		id: 'signal',
		n: '01',
		name: 'Signal',
		gloss: 'Instrumentation',
		blurb:
			'The bench a system is measured on. Traces, thresholds, telemetry. The mark is a graticule with a trace running through it, and the three bars become signal levels. Fits the way the group actually talks about evals — did it work, how would you know, when did it stop.',
		mark: 'reticle',
		accent: 'Green carries actions and healthy state, amber marks labels and thresholds, blue is data under measurement.',
		wordmark: 'stroke',
	},
	{
		id: 'latent',
		n: '02',
		name: 'Latent',
		gloss: 'Representation',
		blurb:
			'Vectors, neighbourhoods, the geometry of an embedding. The mark is three nodes with their edges; the bars become ticks along a dimension. This is the one that keeps the gyroid honest — a minimal surface already reads as a learned manifold rather than three inks on a sheet.',
		mark: 'graph',
		accent: 'Violet carries actions, warm gold marks labels, teal is the second axis.',
		wordmark: 'stroke',
	},
	{
		id: 'terminal',
		n: '03',
		name: 'Terminal',
		gloss: 'The working surface',
		blurb:
			'Where the work actually happens: a shell, a diff, a log. The mark is a block caret, the bars are a diff gutter, and AI is set as a selection rather than an outline. The most literal of the three, and the closest to what people in the room stare at all day.',
		mark: 'caret',
		accent: 'Green carries actions, amber marks labels, red is the attention colour.',
		wordmark: 'block',
	},
];

const ROWS = [
	{ name: 'Harnesses', note: 'The tooling and scaffolding around a model, where much of the engineering effort sits.' },
	{ name: 'Evals', note: 'Measuring whether a system works, and noticing when it stops working.' },
];
---

<Layout title="lAIpzig — visual direction, three variants">
	<main class="page">
		<header class="shell intro">
			<p class="kicker">Visual direction</p>
			<h1>Three replacements for the press</h1>
			<p class="sub">
				The current palette and marks are a printing metaphor &mdash; ink and
				paper, a registration target, ink&#8209;density bars, plates coming into
				register. Each variant below swaps the metaphor for one that means
				something in this subject, keeping the structure, the type system and
				the gyroid intact.
			</p>
		</header>

		{
			VARIANTS.map((v) => (
				<section class="variant" data-variant={v.id}>
					<div class="shell">
						<div class="v-head">
							<span class="v-n">{v.n}</span>
							<div>
								<h2 class="v-name">
									{v.name} <span class="v-gloss">&mdash; {v.gloss}</span>
								</h2>
								<p class="v-blurb">{v.blurb}</p>
								<p class="v-accent">{v.accent}</p>
							</div>
						</div>

						<div class="stage">
							{/* --- nav row ------------------------------------------ */}
							<div class="s-nav">
								<span class="brand">
									<span class="mark" data-mark={v.mark}>
										{v.mark === 'reticle' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<circle cx="12" cy="12" r="7.5" class="dim" />
												<path d="M0 12h24M12 0v24" class="dim" />
												<path d="M2 12 L7 12 L9 6 L12 18 L15 9 L17 12 L22 12" class="live" />
											</svg>
										)}
										{v.mark === 'graph' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M5 18 L12 5 L19 15 L5 18" class="dim" />
												<circle cx="5" cy="18" r="2.4" class="live" />
												<circle cx="12" cy="5" r="2.4" class="live2" />
												<circle cx="19" cy="15" r="2.4" class="live3" />
											</svg>
										)}
										{v.mark === 'caret' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M3 5 L10 12 L3 19" class="dim" />
												<rect x="13" y="4" width="8" height="16" class="live" />
											</svg>
										)}
									</span>
									<span class="wordmark sm" data-wm={v.wordmark}>
										l<span class="ai">AI</span>pzig
									</span>
								</span>
								<span class="s-links">
									<i>About</i>
									<i>Topics</i>
									<i>Format</i>
									<b class="pill">Attend</b>
								</span>
							</div>

							{/* --- hero ---------------------------------------------- */}
							<p class="wordmark lg" data-wm={v.wordmark}>
								l<span class="ai">AI</span>pzig
							</p>
							<p class="s-label">Monthly AI meetup in Leipzig</p>
							<p class="s-lede">
								A monthly meetup for people working with AI in and around
								Leipzig &mdash; developers, researchers, students, and anyone
								curious about the field.
							</p>

							{/* --- section head -------------------------------------- */}
							<div class="s-sec">
								<span class="marks">
									<span class="mark sm" data-mark={v.mark}>
										{v.mark === 'reticle' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<circle cx="12" cy="12" r="7.5" class="dim" />
												<path d="M0 12h24M12 0v24" class="dim" />
												<path d="M2 12 L7 12 L9 6 L12 18 L15 9 L17 12 L22 12" class="live" />
											</svg>
										)}
										{v.mark === 'graph' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M5 18 L12 5 L19 15 L5 18" class="dim" />
												<circle cx="5" cy="18" r="2.4" class="live" />
												<circle cx="12" cy="5" r="2.4" class="live2" />
												<circle cx="19" cy="15" r="2.4" class="live3" />
											</svg>
										)}
										{v.mark === 'caret' && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M3 5 L10 12 L3 19" class="dim" />
												<rect x="13" y="4" width="8" height="16" class="live" />
											</svg>
										)}
									</span>
									<span class="bars" data-bars={v.id}>
										<i></i><i></i><i></i>
									</span>
								</span>
								<span class="s-seclabel">Topics</span>
								<span class="s-secnote">Recurring subjects across our sessions</span>
							</div>

							{/* --- rows ---------------------------------------------- */}
							<ul class="s-rows">
								{ROWS.map((r) => (
									<li>
										<span class="r-name">{r.name}</span>
										<span class="r-note">{r.note}</span>
									</li>
								))}
							</ul>

							{/* --- emphasis + swatches -------------------------------- */}
							<p class="s-emph">
								For people building with <em>AI</em> in Leipzig.
							</p>

							<div class="swatches">
								<span><i style="background: var(--v-ground)"></i>ground</span>
								<span><i style="background: var(--v-text)"></i>text</span>
								<span><i style="background: var(--v-text-2)"></i>text&#8209;2</span>
								<span><i style="background: var(--v-text-3)"></i>text&#8209;3</span>
								<span><i style="background: var(--v-action)"></i>action</span>
								<span><i style="background: var(--v-label)"></i>label</span>
								<span><i style="background: var(--v-attn)"></i>attention</span>
							</div>
						</div>
					</div>
				</section>
			))
		}
	</main>
</Layout>

<script is:inline>
	// The page is prerendered, so Astro.url.searchParams is empty at build time.
	// ?only=<id> is applied here instead, before first paint.
	(() => {
		const only = new URLSearchParams(location.search).get('only');
		if (!only) return;
		for (const el of document.querySelectorAll('.variant')) {
			if (el.dataset.variant !== only) el.hidden = true;
		}
		const intro = document.querySelector('.intro');
		if (intro) intro.hidden = true;
	})();
</script>

<style>
	.page {
		background: #0a0a0c;
		min-height: 100vh;
		padding-block: var(--space-10) var(--space-20);
	}

	/* ---- intro ---------------------------------------------------------- */

	.intro {
		padding-bottom: var(--space-10);
	}

	.kicker {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: 600;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: #8a8a99;
		margin: 0 0 var(--space-2);
	}

	.intro h1 {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 118, 'wght' 400;
		font-weight: 400;
		font-size: var(--text-heading);
		line-height: 1.02;
		letter-spacing: var(--tracking-display);
		margin: 0 0 var(--space-3);
		color: #ededf2;
	}

	.sub {
		margin: 0;
		max-width: 46rem;
		font-size: var(--text-body);
		font-weight: 300;
		line-height: 1.5;
		color: #a9a9b8;
		text-wrap: pretty;
	}

	/* ---- per-variant palettes ------------------------------------------- */

	[data-variant='signal'] {
		--v-ground: #05080b;
		--v-text: #e6efe9;
		--v-text-2: #a7b6b0;
		--v-text-3: #85958f;
		--v-action: #35d68a;
		--v-label: #ffb020;
		--v-attn: #4cc9f0;
	}

	[data-variant='latent'] {
		--v-ground: #07060f;
		--v-text: #e9e8f5;
		--v-text-2: #aaa6c4;
		--v-text-3: #8884a3;
		--v-action: #8b7bff;
		--v-label: #ffcf6b;
		--v-attn: #2fd9c7;
	}

	[data-variant='terminal'] {
		--v-ground: #0b0b0b;
		--v-text: #e6e6e6;
		--v-text-2: #a8a8a8;
		--v-text-3: #858585;
		--v-action: #4bd97a;
		--v-label: #e0a53c;
		--v-attn: #f0614d;
	}

	/* ---- variant frame -------------------------------------------------- */

	.variant {
		padding-block: var(--space-6);
	}

	.v-head {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		gap: var(--space-3);
		max-width: 52rem;
		padding-bottom: var(--space-4);
	}

	.v-n {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: 600;
		letter-spacing: var(--tracking-label);
		color: var(--v-action);
		padding-top: 0.55rem;
	}

	.v-name {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 112, 'wght' 400;
		font-weight: 400;
		font-size: var(--text-heading-2xs);
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-2);
		color: #ededf2;
	}

	.v-gloss {
		color: #7c7c8a;
	}

	.v-blurb,
	.v-accent {
		margin: 0 0 var(--space-2);
		font-size: 0.9375rem;
		font-weight: 300;
		line-height: 1.55;
		color: #9a9aab;
		text-wrap: pretty;
	}

	.v-accent {
		color: #77778a;
		margin-bottom: 0;
	}

	/* ---- the specimen --------------------------------------------------- */

	.stage {
		background: var(--v-ground);
		color: var(--v-text);
		border-radius: var(--radius);
		padding: clamp(var(--space-4), 4vw, var(--space-10));
		overflow: hidden;
	}

	.s-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-bottom: var(--space-10);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.mark {
		display: inline-flex;
		width: 17px;
		height: 17px;
	}

	.mark.sm {
		width: 15px;
		height: 15px;
	}

	.mark svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke-width: 1.3;
	}

	.mark .dim {
		stroke: var(--v-text-3);
	}

	.mark .live {
		stroke: var(--v-action);
	}

	.mark .live2 {
		stroke: var(--v-label);
	}

	.mark .live3 {
		stroke: var(--v-attn);
	}

	/* the caret's block is filled, not stroked */
	[data-mark='caret'] .live {
		fill: var(--v-action);
		stroke: none;
	}

	/* the graph's nodes are filled discs */
	[data-mark='graph'] .live,
	[data-mark='graph'] .live2,
	[data-mark='graph'] .live3 {
		stroke: none;
	}
	[data-mark='graph'] .live {
		fill: var(--v-action);
	}
	[data-mark='graph'] .live2 {
		fill: var(--v-label);
	}
	[data-mark='graph'] .live3 {
		fill: var(--v-attn);
	}

	.s-links {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.s-links i {
		font-style: normal;
		color: var(--v-text-3);
	}

	.pill {
		font-weight: 500;
		padding: 0.7rem 1.1rem;
		border-radius: var(--radius-pill);
		background: var(--v-action);
		color: var(--v-ground);
	}

	/* ---- wordmark ------------------------------------------------------- */

	.wordmark {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 138, 'wght' 400;
		font-weight: 400;
		letter-spacing: var(--tracking-display);
		white-space: nowrap;
		margin: 0;
		line-height: 0.9;
	}

	.wordmark.sm {
		font-size: var(--text-nav);
		font-variation-settings: 'wdth' 126, 'wght' 400;
		letter-spacing: -0.01em;
	}

	.wordmark.lg {
		font-size: clamp(2.5rem, 9vw, 6rem);
	}

	/* AI as a cut-through, or as a selection */
	[data-wm='stroke'] .ai {
		color: transparent;
		-webkit-text-stroke: 0.014em var(--v-text);
		paint-order: stroke fill;
	}

	.wordmark.sm[data-wm='stroke'] .ai {
		-webkit-text-stroke-width: 0.04em;
	}

	[data-wm='block'] .ai {
		background: var(--v-action);
		color: var(--v-ground);
		padding-inline: 0.04em;
	}

	/* ---- hero copy ------------------------------------------------------ */

	.s-label {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: 600;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--v-label);
		margin: var(--space-4) 0 var(--space-2);
	}

	.s-lede {
		margin: 0;
		max-width: 30rem;
		font-size: var(--text-body);
		font-weight: 300;
		line-height: 1.5;
		color: var(--v-text-2);
		text-wrap: pretty;
	}

	/* ---- section head --------------------------------------------------- */

	.s-sec {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-10) 0 var(--space-4);
	}

	.marks {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}

	.bars {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 11px;
	}

	.bars i {
		width: 10px;
	}

	/* Signal: levels on a meter. */
	[data-bars='signal'] i:nth-child(1) {
		height: 4px;
		background: var(--v-action);
	}
	[data-bars='signal'] i:nth-child(2) {
		height: 8px;
		background: var(--v-action);
	}
	[data-bars='signal'] i:nth-child(3) {
		height: 11px;
		background: var(--v-label);
	}

	/* Latent: ticks along a dimension. */
	[data-bars='latent'] i {
		width: 3px;
		height: 11px;
	}
	[data-bars='latent'] i:nth-child(1) {
		background: var(--v-action);
	}
	[data-bars='latent'] i:nth-child(2) {
		background: var(--v-label);
		height: 7px;
	}
	[data-bars='latent'] i:nth-child(3) {
		background: var(--v-attn);
		height: 9px;
	}

	/* Terminal: a diff gutter. */
	[data-bars='terminal'] i {
		height: 3px;
	}
	[data-bars='terminal'] i:nth-child(1) {
		background: var(--v-action);
	}
	[data-bars='terminal'] i:nth-child(2) {
		background: var(--v-attn);
	}
	[data-bars='terminal'] i:nth-child(3) {
		background: var(--v-text-3);
	}

	.s-seclabel {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		font-weight: 600;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--v-label);
		white-space: nowrap;
	}

	.s-secnote {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		letter-spacing: 0.06em;
		color: var(--v-text-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ---- rows ----------------------------------------------------------- */

	.s-rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.s-rows li {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
		gap: var(--space-4);
		align-items: baseline;
		padding: var(--space-3) 0;
	}

	.r-name {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 100, 'wght' 400;
		font-weight: 400;
		font-size: var(--text-subheading);
		letter-spacing: var(--tracking-display);
		line-height: 1.02;
	}

	.r-note {
		font-size: var(--text-body);
		font-weight: 300;
		line-height: 1.5;
		color: var(--v-text-3);
		max-width: 40ch;
		text-wrap: pretty;
	}

	/* ---- emphasis treatment --------------------------------------------- */

	.s-emph {
		font-family: var(--font-display);
		font-variation-settings: 'wdth' 118, 'wght' 400;
		font-weight: 400;
		font-size: var(--text-heading-sm);
		letter-spacing: var(--tracking-display);
		line-height: 1.05;
		margin: var(--space-10) 0 0;
	}

	.s-emph em {
		font-style: normal;
	}

	/* Signal: an unterminated echo trailing the glyph. */
	[data-variant='signal'] .s-emph em {
		text-shadow:
			0.05em 0 0 color-mix(in srgb, var(--v-action) 55%, transparent),
			0.1em 0 0 color-mix(in srgb, var(--v-attn) 28%, transparent);
	}

	/* Latent: the nearest neighbours of the word. */
	[data-variant='latent'] .s-emph em {
		text-shadow:
			0.028em -0.02em 0 var(--v-action),
			-0.026em 0.02em 0 var(--v-attn);
	}

	/* Terminal: a selection. */
	[data-variant='terminal'] .s-emph em {
		background: var(--v-action);
		color: var(--v-ground);
		padding-inline: 0.06em;
	}

	/* ---- swatches ------------------------------------------------------- */

	.swatches {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-10);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--v-text-3);
	}

	.swatches span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.swatches i {
		width: 16px;
		height: 16px;
		border-radius: 4px;
		outline: 1px solid rgba(255, 255, 255, 0.14);
		outline-offset: -1px;
	}

	@media (max-width: 780px) {
		.v-head {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}

		.s-rows li {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}

		.s-links i {
			display: none;
		}
	}
</style>
