---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'lAIpzig Meetup — an AI meetup in Leipzig',
	description =
		'A monthly AI meetup in Leipzig for developers, researchers and students working with machine learning, LLMs and agents. Two short talks, open demos, and discussion. Free to attend.',
} = Astro.props;
---

<html lang="en">
	<head>
		<script is:inline>
			// Set before first paint: the scroll-reveal styles hook off .js so the
			// page degrades to fully visible when scripts don't run.
			document.documentElement.classList.add('js');
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0B0B0B" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="en" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..150,300..900&family=Archivo:wght@200..700&family=Martian+Mono:wght@400..600&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
